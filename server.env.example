# Server deployment variables, loaded after .env:
#   docker compose --env-file .env --env-file server.env up -d
# server_setup.sh copies this file to server.env and later adds variables that are missing there.
# Keep values without spaces: scripts also read this file with "." (sh).

# Pinned Zabbix version, change manually on upgrade
ZBX_IMAGE_TAG=alpine-7.4.15

# Web for LAN access only, never forwarded in NAT: public access goes through Cloudflare Tunnel
ZABBIX_WEB_NGINX_HTTP_PORT=80
ZABBIX_WEB_NGINX_HTTPS_PORT=443
# Zabbix server trapper (10051): active checks of local and LAN agents, proxies (not forwarded in NAT)
# Use 127.0.0.1 to accept only local agent 2
ZABBIX_SERVER_BIND_IP=0.0.0.0

COMPOSE_FILE=docker-compose.yml:compose_server.yaml
COMPOSE_PROJECT_NAME=zabbix
# Start complementary services (agent 2, snmptraps, web service, cloudflared)
COMPOSE_PROFILES=postgres-nginx

# Cloudflare Tunnel connector, pinned version, change manually on upgrade
# Token is in env_vars/.CLOUDFLARE_TUNNEL_TOKEN (server_setup.sh)
CLOUDFLARED_IMAGE_TAG=2026.9.3

# Self-signed origin certificate (server_certificate.sh): public name and LAN address
CERT_DOMAIN=zabbix.likson.com
CERT_LAN_IP=192.168.0.191

# Backups (server_backup.sh)
BACKUP_RETENTION_DAYS=7
