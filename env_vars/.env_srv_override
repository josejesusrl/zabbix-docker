# Deployment overrides for .env_srv
ZBX_ENABLE_SNMP_TRAPS=true
# Scheduled reports through zabbix-web-service
ZBX_STARTREPORTWRITERS=1
ZBX_WEBSERVICEURL=http://zabbix-web-service:10053/report
# Configuration cache: default 32M was 73% used with 40 hosts (item zabbix[rcache,buffer,pused])
ZBX_CACHESIZE=128M
# ICMP pingers: 1 process was 63% busy (item zabbix[process,icmp pinger,avg,busy])
ZBX_STARTPINGERS=3
