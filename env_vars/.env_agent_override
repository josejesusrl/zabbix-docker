# Deployment overrides for .env_agent (agent 2 runs with network_mode: host)
# Hostname matches default "Zabbix server" host created in database
ZBX_HOSTNAME=Zabbix server
# Active checks go to server port published on host loopback.
# ZBX_SERVER_HOST is also added to allowed passive servers by the entrypoint.
ZBX_SERVER_HOST=127.0.0.1
# Passive checks come from server container through frontend network
ZBX_PASSIVESERVERS=172.16.238.0/24
